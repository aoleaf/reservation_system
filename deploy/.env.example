# 本番の .env（サーバーの deploy/.env に写して、値を書く。この中身は AI に渡さない）

# ---- Docker（compose が読む）----
APP_DOMAIN=yoyaku.example.com
IMAGE_PREFIX=ghcr.io/aoleaf/reservation_system
IMAGE_TAG=latest
DB_ROOT_PASSWORD=

# ---- アプリ ----
APP_NAME=つちのね
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://yoyaku.example.com
APP_TIMEZONE=Asia/Tokyo
LOG_CHANNEL=daily
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=tsuchinone
DB_USERNAME=tsuchinone
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=resend
RESEND_KEY=
MAIL_FROM_ADDRESS="yoyaku@mail.example.com"
MAIL_FROM_NAME="つちのね"

STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
